<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- assign menu = section.settings.menu %}
{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign total_active_values = 0
  for filter in search.filters
    assign total_active_values = total_active_values | plus: filter.active_values.size
  endfor
-%}

<style>
  #FacetFiltersPillsSearchForm:not(:has(facet-remove.active-facets__item)) {
    display: none;
  }
</style>

<div class="collection_container">
  {% render 'facets-custom', results: collection -%}
  <div class="collection_inner">
    <div class="collection_search mb-head --pad">
      <h3 class="title">Keyword Search:</h3>
      <p class="keyword">{{ search.terms | escape }}</p>
    </div>

    <facet-filters-form>
      <form
        id="FacetFiltersPillsSearchForm"
        {% if total_active_values == 0 %}
          class="hidden"
        {% endif %}
      >
        <div class="collection_filter mb-head --pad">
          <h3 class="title">Shoes / Filter Search</h3>
          <div class="collection_filter_inner">
            <div class="active-facets active-facets-desktop">
              <span
                class="visually-hidden active-facets_active--count"
                data-count-active="{{ total_active_values }}"
              ></span>
              {%- for filter in search.filters -%}
                {%- for value in filter.active_values -%}
                  <facet-remove class="active-facets__item">
                    <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                      <span class="active-facets__button-inner button button--tertiary">
                        {{ filter.label | escape }}: {{ value.label | escape }}
                        {% render 'icon-close-small' %}
                        <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                      </span>
                    </a>
                  </facet-remove>
                {%- endfor -%}
              {%- endfor -%}
            </div>
            <facet-remove class="active-facets__button-wrapper u-hoverlink pc-only">
              <a href="{{ search_url }}" class="active-facets__button-remove underlined-link">
                <span>Clear</span>
              </a>
            </facet-remove>
          </div>
        </div>
      </form>
    </facet-filters-form>

    {% paginate search.results by 24 %}
      <div class="collection_options c-navi">
        <div id="navi-category" class="c-navi_category js-navi_option">
          <div class="c-mega">
            <div class="c-mega_container">
              <div class="c-mega_inner">
                <div class="c-mega_left js-options-tab">
                  <p class="tab-option active" data-tab="brand">Brand</p>
                  <p class="tab-option" data-tab="type">Type</p>
                  <a href="/collections/all" class="u-hoverlink-2 pc-only">View All</a>
                  <span class="is-indicator"></span>
                </div>
                <div class="c-mega_right">
                  {%- for link in menu.links -%}
                    <div
                      class="c-mega_tabs {% if link.title contains 'Brand' %}active{% endif %}"
                      id="{% if link.title contains 'Brand' %}option-brand{% else %}option-type{% endif %}"
                    >
                      <div class="c-mega_list">
                        {%- for childlink in link.links -%}
                          <a href="{{ childlink.url }}" class="c-mega_items">
                            {%- assign object = childlink.object -%}
                            <figure>
                              {% if object.featured_image %}
                                <img
                                  src="{{ object.featured_image | image_url: width: 400 }}"
                                  alt="{{ childlink.title }}"
                                  width=""
                                  height=""
                                >
                              {% endif %}
                            </figure>
                            <p>{{ childlink.title }}</p>
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>

                <div class="c-mega_viewall sp-only">
                  <a href="/collections/all" class="c-btn-link">View All</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="facets-container">
          <facet-filters-form class="facets">
            {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
            <form class="facets-vertical-form" id="FacetSortForm">
              <input type="hidden" name="q" value="{{ search.terms | escape }}">
              <input name="options[prefix]" type="hidden" value="last">
              <div id="navi-sort" class="c-navi_sort js-navi_option facet-filters">
                <ul>
                  {%- for sort_option in search.sort_options -%}
                    <li
                      {% if sort_option.value == sort_by %}
                        class="is-active"
                      {% endif %}
                    >
                      <a href="javascript:;" data-name="{{ sort_option.value | escape }}">
                        {{ sort_option.name }}
                        <span class="arrow"></span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
                <div class="select hidden" id="js-slectedSort">
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon-caret' %}
                </div>
              </div>
            </form>
          </facet-filters-form>
        </div>

        <div class="c-navi_btn --pad">
          <button class="c-navi_btn_option js-navi_btn_option" data-target="navi-category">
            <p>Category</p>
            <span class="ico-plus"></span>
          </button>
          <button class="c-navi_btn_option js-navi_btn_option" data-target="navi-sort">
            <p>Sort</p>
            <span class="ico-plus"></span>
          </button>
          <div
            class="product-count light hidden"
            role="status"
          >
            <h2 class="product-count__text text-body">
              <span id="ProductCount">
                {%- if search.results_count -%}
                  {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                {%- elsif search.products_count == search.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: search.products_count, count: search.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </div>
      </div>

      <div class="--pad">
        <div
          class="product-grid-container"
          id="ProductGridContainer"
        >
          {%- if search.results.size == 0 -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="collection"
            >
              <div class="loading-overlay gradient"></div>
              <div
                class="collection_list"
                id="product-grid"
                data-id="{{ section.id }}"
              >
                {%- for item in search.results -%}
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      <div class="collection_items">
                        {% render 'product-item', product: item -%}
                      </div>
                  {%- endcase -%}
                {%- endfor -%}
              </div>
            </div>
          {% endif %}

          {%- if paginate.pages > 1 -%}
            <div class="collection_control c-control">
              <div class="c-control_pager u-hoverlink">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}">Prev</a>
                {%- endif -%}
              </div>

              <div class="c-control_pagination">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" data-page="{{ part.title }}" aria-label="{{ part.title }}">
                      {{- part.title -}}
                    </a>
                  {%- else -%}
                    <a
                      href="javascript:;"
                      {% if part.title == paginate.current_page %}
                        class="active"
                      {% endif %}
                      aria-label="{{ part.title }}"
                    >
                      {{- part.title -}}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="c-control_pager u-hoverlink">
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}">Next</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>
{% schema %}
{
  "name": "Search page",
  "class": "collectionspage",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Category menu"
    }
  ]
}
{% endschema %}
